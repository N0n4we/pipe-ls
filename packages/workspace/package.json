{
  "name": "@pipe-ls/workspace",
  "version": "0.1.0",
  "description": "Read-only project discovery and snapshots for pipe-ls",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@pipe-ls/core": "workspace:*",
    "@pipe-ls/hosts": "workspace:*"
  }
}
