{
  "schemaVersion": 1,
  "purpose": "First-version CLI diagnostic oracles and controlled parse/update runtime inputs; synthetic dependencies do not make the original fixture complete",
  "cases": [
    {
      "id": "tag-aws",
      "kind": "positive",
      "entry": ".github/workflows/cloud.yaml",
      "input": {
        "environment": "staging",
        "images": "xxxxxxxxxxxx.dkr.ecr.us-west-2.amazonaws.com/cloud-admin-frontend:dev"
      },
      "requires": [
        "synthetic-overlays",
        "real-reusable-workflow",
        "synthetic-tool-pins"
      ],
      "expectedFacts": [
        "one JSON string enters parse stdin",
        "tag variant, no digest key",
        "one aws restart target"
      ]
    },
    {
      "id": "digest-aws",
      "kind": "positive",
      "entry": ".github/workflows/cloud.yaml",
      "input": {
        "environment": "staging",
        "images": "xxxxxxxxxxxx.dkr.ecr.us-west-2.amazonaws.com/cloud-admin-frontend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "requires": [
        "synthetic-overlays",
        "real-reusable-workflow",
        "synthetic-tool-pins"
      ],
      "expectedFacts": ["digest variant, no tag key", "one aws restart target"]
    },
    {
      "id": "dual-platform",
      "kind": "positive",
      "entry": ".github/workflows/cloud.yaml",
      "input": {
        "environment": "staging",
        "images": "xxxxxxxxxxxx.dkr.ecr.us-west-2.amazonaws.com/cloud-admin-frontend:dev,swr.cn-east-3.myhuaweicloud.com/cloud-console/cloud-admin-frontend:dev"
      },
      "requires": [
        "synthetic-overlays",
        "real-reusable-workflow",
        "synthetic-tool-pins"
      ],
      "expectedFacts": [
        "two platform keys with closed restart target union",
        "Huawei restart permitted when AWS is skipped"
      ]
    },
    {
      "id": "update-only-empty-restart",
      "kind": "positive",
      "entry": ".github/workflows/cloud.yaml",
      "input": {
        "environment": "staging",
        "images": "xxxxxxxxxxxx.dkr.ecr.us-west-2.amazonaws.com/cloud-cost-exporter:dev"
      },
      "requires": [
        "synthetic-overlays",
        "real-reusable-workflow",
        "synthetic-tool-pins"
      ],
      "expectedFacts": [
        "restart_targets is exactly {}",
        "update result remains one JSON object"
      ]
    },
    {
      "id": "special-chars-env",
      "kind": "positive",
      "entry": ".github/workflows/cloud.yaml",
      "input": {
        "environment": "staging",
        "images": "xxxxxxxxxxxx.dkr.ecr.us-west-2.amazonaws.com/cloud-admin-frontend:dev",
        "distinct_id": "quote\" backslash\\ newline\n😀"
      },
      "requires": [
        "synthetic-overlays",
        "real-reusable-workflow",
        "synthetic-tool-pins"
      ],
      "expectedFacts": [
        "toJSON env preserves quote, backslash, LF and emoji",
        "run consumes JSON string without stdout return"
      ]
    },
    {
      "id": "position-argument",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "parse-cloud-images.sh <<< \"$IMAGES_INPUT\"",
        "replace": "parse-cloud-images.sh \"$IMAGES_INPUT\""
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": ["business input may not move to positional argv"]
    },
    {
      "id": "bare-platform-env",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "IMAGES_INPUT: ${{ toJSON(inputs.images) }}",
        "replace": "IMAGES_INPUT: ${{ inputs.images }}"
      },
      "expectedCodes": ["PIPE101"],
      "expectedFacts": [
        "platform string is not automatically JSON string encoding"
      ]
    },
    {
      "id": "bare-script-stdin",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "parse-cloud-images.sh <<< \"$IMAGES_INPUT\"",
        "replace": "parse-cloud-images.sh <<< \"$(jq -r '.' <<< \"$IMAGES_INPUT\")\""
      },
      "expectedCodes": ["PIPE101"],
      "expectedFacts": [
        "jq -r strips JSON string encoding before script boundary"
      ]
    },
    {
      "id": "double-encoded-nested-object",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "--argjson parsed_images \"$parsed_images_json\"",
        "replace": "--arg parsed_images \"$parsed_images_json\""
      },
      "expectedCodes": ["PIPE102"],
      "expectedFacts": [
        "parsed_images becomes JSON string instead of nested object"
      ]
    },
    {
      "id": "missing-required-field",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "{environment: $environment, parsed_images: $parsed_images}",
        "replace": "{environment: $environment}"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": ["update stdin lacks required parsed_images field"]
    },
    {
      "id": "consume-undeclared-stdout",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/scripts/parse-cloud-images.sh",
        "removeLineStarting": "# @pipe stdout:"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "caller captures parse script even though it no longer declares stdout"
      ]
    },
    {
      "id": "missing-job-output-map",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "removeLineStarting": "      restart_targets: ${{ steps.setup.outputs.restart_targets }}"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": ["needs.update cannot consume unmapped job output"]
    },
    {
      "id": "conditional-step-output",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "id: setup\n        env:",
        "replace": "id: setup\n        if: ${{ inputs.environment == 'prod' }}\n        env:"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "skipped setup leaves output absent; downstream use cannot assume it exists"
      ]
    },
    {
      "id": "missing-required-env",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "removeLineStarting": "          DEPLOY_ENVIRONMENT: ${{ toJSON(inputs.environment) }}"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "run declares DEPLOY_ENVIRONMENT but caller does not supply it"
      ]
    },
    {
      "id": "missing-reusable-secret",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "    secrets: inherit\n\n  restart_huaweicloud:",
        "replace": "\n  restart_huaweicloud:"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "restart_aws must supply the callee's required secret even when unrelated workflow analysis is blocked"
      ]
    },
    {
      "id": "consume-ci-without-workflow-output",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "snippet": "on: workflow_dispatch\njobs:\n  call:\n    uses: ./.github/workflows/cloud.yaml\n  consumer:\n    needs: call\n    runs-on: ubuntu-latest\n    steps:\n      - env:\n          RESULT: ${{ toJSON(needs.call.outputs.restart_targets) }}\n        run: 'echo no-business-output'\n",
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "cloud.yaml has neither workflow_call nor workflow-level outputs"
      ]
    },
    {
      "id": "secret-action-env-only-output-consumer",
      "kind": "negative",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/do-rollout-restart.yaml",
        "search": "          export-env: false",
        "replace": "          export-env: true"
      },
      "expectedCodes": ["PIPE104"],
      "expectedFacts": [
        "1Password export-env true does not declare secret step outputs",
        "AWS credential validator and Huawei env cannot consume these nonexistent outputs",
        "bounded action models do not prove authentication, secret bytes or concrete file effects"
      ]
    },
    {
      "id": "jq-raw-stdout-string",
      "kind": "negative",
      "entry": ".github/scripts/parse-cloud-images.sh",
      "snippet": "# @pipe stdin: {\"name\": string}\n# @pipe stdout: string\njq -r '.name'\n",
      "expectedCodes": ["PIPE101"],
      "expectedFacts": ["jq -r removes the required JSON string encoding"]
    },
    {
      "id": "jq-multiple-stdout-values",
      "kind": "negative",
      "entry": ".github/scripts/parse-cloud-images.sh",
      "snippet": "# @pipe stdout: number\njq -n '1, 2'\n",
      "expectedCodes": ["PIPE103"],
      "expectedFacts": ["declared stdout requires one JSON value, not two"]
    },
    {
      "id": "stdin-read-after-eof",
      "kind": "negative",
      "entry": ".github/scripts/parse-cloud-images.sh",
      "snippet": "# @pipe stdin: number\n# @pipe stdout: number\njq '.' >/dev/null\njq '.'\n",
      "expectedCodes": ["PIPE103"],
      "expectedFacts": [
        "the second jq sees EOF and produces no declared return"
      ]
    },
    {
      "id": "missing-overlays",
      "kind": "blocked",
      "entry": ".github/scripts/update-cloud-images.sh",
      "missingDependency": "resources/cloud/overlays/staging/aws/kustomization.yaml",
      "expectedCodes": ["PIPE204"],
      "expectedFacts": [
        "independent interface checks continue, full file/effect proof is incomplete"
      ]
    },
    {
      "id": "missing-reusable-workflow",
      "kind": "blocked",
      "entry": ".github/workflows/cloud.yaml",
      "mutation": {
        "target": ".github/workflows/cloud.yaml",
        "search": "uses: ./.github/workflows/do-rollout-restart.yaml\n    with:\n      platform: ${{ toJSON('aws') }}",
        "replace": "uses: ./.github/workflows/missing-rollout-restart.yaml\n    with:\n      platform: ${{ toJSON('aws') }}"
      },
      "missingDependency": ".github/workflows/missing-rollout-restart.yaml",
      "expectedCodes": ["PIPE204"],
      "expectedFacts": [
        "do not infer called workflow input/output contract from caller"
      ]
    },
    {
      "id": "unsupported-source-effect",
      "kind": "blocked",
      "entry": ".github/scripts/parse-cloud-images.sh",
      "snippet": "# @pipe stdout: number\nsource ./dynamic.sh\nprintf '%s\\n' '1'\n",
      "expectedCodes": ["PIPE202"],
      "expectedFacts": [
        "source may change command resolution and cannot be skipped"
      ]
    },
    {
      "id": "unknown-business-command",
      "kind": "blocked",
      "entry": ".github/scripts/parse-cloud-images.sh",
      "snippet": "# @pipe stdout: number\nbusiness-command\n",
      "expectedCodes": ["PIPE201"],
      "expectedFacts": ["no command signature means no inferred stdout type"]
    },
    {
      "id": "dynamic-run-interpolation",
      "kind": "blocked",
      "entry": ".github/workflows/cloud.yaml",
      "snippet": "on:\n  workflow_dispatch:\n    inputs:\n      script:\n        type: string\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - shell: bash\n        run: ${{ inputs.script }}\n",
      "expectedCodes": ["PIPE203"],
      "expectedFacts": [
        "unknown run interpolation may change Bash syntax; recovery AST cannot prove semantics"
      ]
    }
  ]
}
